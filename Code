package ParkWise;

import java.util.HashMap;
import java.util.Map;

public class Hash_Table {

    // Create Hash Table
    private HashMap<String, String> vehicles;

    public Hash_Table() {
        vehicles = new HashMap<>();
    }

    // INSERT: Register vehicle
    public void insertVehicle(String plateNumber, String information) {

        if (vehicles.containsKey(plateNumber)) {
            System.out.println("Plate number already registered!");
        } else {
            vehicles.put(plateNumber, information);
            System.out.println("Vehicle successfully registered!");
        }
    }

    // SEARCH: Find vehicle
    public void searchVehicle(String plateNumber) {

        if (vehicles.containsKey(plateNumber)) {
            System.out.println("Vehicle Found!");
            System.out.println("Plate Number: " + plateNumber);
            System.out.println("Information: " + vehicles.get(plateNumber));
        } else {
            System.out.println("Vehicle not found!");
        }
    }

    // DISPLAY: Show all vehicles
    public void displayVehicles() {

        if (vehicles.isEmpty()) {
            System.out.println("No registered vehicles.");
            return;
        }

        System.out.println("\n===== REGISTERED VEHICLES =====");

        for (Map.Entry<String, String> entry : vehicles.entrySet()) {
            System.out.println("Plate Number: " + entry.getKey());
            System.out.println("Information: " + entry.getValue());
            System.out.println("-------------------------");
        }
    }

    // DELETE: Remove vehicle
    public void deleteVehicle(String plateNumber) {

        if (vehicles.containsKey(plateNumber)) {
            vehicles.remove(plateNumber);
            System.out.println("Vehicle successfully removed!");
        } else {
            System.out.println("Vehicle not found!");
        }
    }
}

package ParkWise;


public class Main {

    public static void main(String[] args) {

        Hash_Table parking = new Hash_Table();

        // INSERT VEHICLES
        parking.insertVehicle("ABC-123", "Juan - Car");
        parking.insertVehicle("XYZ-456", "Maria - Motorcycle");
        parking.insertVehicle("DEF-789", "Pedro - Van");

        // DISPLAY VEHICLES
        parking.displayVehicles();

        // SEARCH VEHICLE
        System.out.println("\n===== SEARCH VEHICLE =====");
        parking.searchVehicle("ABC-123");

        // DELETE VEHICLE
        System.out.println("\n===== DELETE VEHICLE =====");
        parking.deleteVehicle("XYZ-456");

        // DISPLAY UPDATED RECORDS
        parking.displayVehicles();
    }
}
